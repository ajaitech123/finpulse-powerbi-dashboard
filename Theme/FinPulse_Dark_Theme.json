{
  "name": "FinPulse Dark",
  "dataColors": ["#2BD9C0","#3D7BFF","#FF4D8D","#9B6BFF","#FFB020","#5FE3F2","#7FE08A","#FF7A59"],
  "background": "#141B4D",
  "foreground": "#FFFFFF",
  "tableAccent": "#3D7BFF",
  "good": "#2BD9C0",
  "neutral": "#FFB020",
  "bad": "#FF4D8D",
  "maximum": "#2BD9C0",
  "center": "#3D7BFF",
  "minimum": "#1B2670",
  "textClasses": {
    "label":   {"fontSize": 10, "fontFace": "Segoe UI", "color": "#B8C2F0"},
    "callout": {"fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF"},
    "title":   {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF"},
    "header":  {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF"}
  },
  "visualStyles": {
    "page": {"*": {"background": [{"color": {"solid": {"color": "#0B1030"}}, "transparency": 0}]}},
    "*": {"*": {
      "background": [{"show": true, "color": {"solid": {"color": "#141B4D"}}, "transparency": 0}],
      "border": [{"show": true, "color": {"solid": {"color": "#2A3580"}}, "radius": 14}],
      "dropShadow": [{"show": true, "color": {"solid": {"color": "#2BD9C0"}}, "transparency": 90, "position": "Outer", "preset": "BottomRight"}],
      "title": [{"show": true, "fontColor": {"solid": {"color": "#FFFFFF"}}, "fontFamily": "Segoe UI Semibold", "fontSize": 12}],
      "labels": [{"color": {"solid": {"color": "#B8C2F0"}}}],
      "categoryAxis": [{"labelColor": {"solid": {"color": "#B8C2F0"}}}],
      "valueAxis": [{"labelColor": {"solid": {"color": "#B8C2F0"}}, "gridlineColor": {"solid": {"color": "#27306F"}}}],
      "legend": [{"labelColor": {"solid": {"color": "#B8C2F0"}}}]
    }}
  }
}
